set -euo pipefail

# CI validation only: feed the real readiness classifier without damaging a disk.
case "${DB_FALLBACK_TEST_INCIDENT:-}" in
    spark-disk-full) failure='No space left on device' ;;
    spark-disk-io) failure='Input/output error' ;;
    *) echo 'No Spark startup incident assigned' >&2; exit 2 ;;
esac
echo "VALIDATION ONLY: synthetic Spark startup failure: $failure" >&2
printf 'java.io.IOException: %s\n' "$failure" >&2
exit 42
